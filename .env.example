# Copy to .env.local.
#
# Leave BACKEND_API_URL unset to run against the built-in local store
# (.data/db.json) — fully functional for development and demos.
#
# Set it to Davis's lea-be-core base URL to make every admin route proxy to the
# real backend (/api/lea/admin/*) instead of the local store. That is the single
# switch that "connects to Davis".
# BACKEND_API_URL=https://lea-be-core.legali.ai
